      ]
    },
    {
      "id": "doc_003",
      "text": "秦昭王与楚婚，欲与怀王会。怀王欲行，屈平曰：秦，虎狼之国，不可信。",
      "entities": [
        {"id": "e1", "text": "秦昭王", "type": "PER", "start": 0, "end": 3},
        {"id": "e2", "text": "楚", "type": "LOC", "start": 4, "end": 5},
