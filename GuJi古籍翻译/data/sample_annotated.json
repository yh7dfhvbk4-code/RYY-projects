    },
    {
      "id": "doc_002",
      "text": "贾生名谊，洛阳人也。年十八，以能诵诗属书闻于郡中。",
      "entities": [
        {"id": "e1", "text": "贾生", "type": "PER", "start": 0, "end": 2},
